# skhd config — your dwm keymap, ported to yabai
# MODKEY = alt  (your dwm Super -> macOS alt)
# dwm binding is noted next to each line.
#
# CHANGE THESE TWO to your tools:
TERMINAL="Alacritty"      # dwm termcmd was alacritty
# launcher: Raycast if installed, else Spotlight is cmd+space by default

# ---------------------------------------------------------------------------
# spawn
# ---------------------------------------------------------------------------
alt - return          : open -na "Alacritty"          # dwm: Mod+Return  (terminal)
alt - p               : open -a "Raycast" 2>/dev/null || open -a "Spotlight"  # dwm: Mod+p (dmenu)

# ---------------------------------------------------------------------------
# focus  (dwm focusstack)
# ---------------------------------------------------------------------------
alt - j               : yabai -m window --focus next || yabai -m window --focus first  # dwm: Mod+j
alt - k               : yabai -m window --focus prev || yabai -m window --focus last   # dwm: Mod+k

# ---------------------------------------------------------------------------
# resize master area  (dwm setmfact)
# ---------------------------------------------------------------------------
alt - h               : yabai -m window --resize left:-40:0  || yabai -m window --resize right:-40:0  # dwm: Mod+h
alt - l               : yabai -m window --resize left:40:0   || yabai -m window --resize right:40:0   # dwm: Mod+l

# ---------------------------------------------------------------------------
# move / swap window directionally  (i3-style, bonus — no tmux clash w/ shift)
# ---------------------------------------------------------------------------
alt + shift - h       : yabai -m window --swap west
alt + shift - j       : yabai -m window --swap south
alt + shift - k       : yabai -m window --swap north
alt + shift - l       : yabai -m window --swap east

# ---------------------------------------------------------------------------
# zoom / promote to master  (dwm Mod+Shift+Return)
# ---------------------------------------------------------------------------
alt + shift - return  : yabai -m window --swap first

# ---------------------------------------------------------------------------
# layouts  (dwm setlayout)
# ---------------------------------------------------------------------------
alt - t               : yabai -m space --layout bsp              # dwm: Mod+t  (tile)
alt - m               : yabai -m space --layout stack            # dwm: Mod+m  (monocle)
alt - f               : yabai -m window --toggle zoom-fullscreen # dwm: Mod+f  (fullscreen)
alt - space           : yabai -m space --rotate 90              # dwm: Mod+space (cycle layout)
alt + shift - space   : yabai -m window --toggle float --grid 4:4:1:1:2:2  # dwm: Mod+Shift+space (float)

# ---------------------------------------------------------------------------
# kill / balance
# ---------------------------------------------------------------------------
alt + shift - q       : yabai -m window --close                  # dwm: Mod+Shift+q (killclient)
alt - i               : yabai -m space --balance                 # dwm: Mod+i  (approx incnmaster)

# ---------------------------------------------------------------------------
# spaces  (dwm tags 1-9)  — needs SIP tweak on some macOS versions
# ---------------------------------------------------------------------------
alt - 1 : yabai -m space --focus 1
alt - 2 : yabai -m space --focus 2
alt - 3 : yabai -m space --focus 3
alt - 4 : yabai -m space --focus 4
alt - 5 : yabai -m space --focus 5
alt - 6 : yabai -m space --focus 6
alt - 7 : yabai -m space --focus 7
alt - 8 : yabai -m space --focus 8
alt - 9 : yabai -m space --focus 9
alt - tab : yabai -m space --focus recent                        # dwm: Mod+Tab (last tag)

# move focused window to space  (dwm Mod+Shift+[1-9])
alt + shift - 1 : yabai -m window --space 1
alt + shift - 2 : yabai -m window --space 2
alt + shift - 3 : yabai -m window --space 3
alt + shift - 4 : yabai -m window --space 4
alt + shift - 5 : yabai -m window --space 5
alt + shift - 6 : yabai -m window --space 6
alt + shift - 7 : yabai -m window --space 7
alt + shift - 8 : yabai -m window --space 8
alt + shift - 9 : yabai -m window --space 9

# ---------------------------------------------------------------------------
# multi-monitor  (dwm focusmon / tagmon)   , = 0x2B   . = 0x2F
# ---------------------------------------------------------------------------
alt - 0x2B            : yabai -m display --focus prev            # dwm: Mod+,
alt - 0x2F            : yabai -m display --focus next            # dwm: Mod+.
alt + shift - 0x2B    : yabai -m window --display prev; yabai -m display --focus prev   # dwm: Mod+Shift+,
alt + shift - 0x2F    : yabai -m window --display next; yabai -m display --focus next   # dwm: Mod+Shift+.

# ---------------------------------------------------------------------------
# restart yabai  (handy)
# ---------------------------------------------------------------------------
alt + shift - r       : yabai --restart-service
