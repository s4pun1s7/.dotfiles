! Generated by pywal from the current wallpaper -- do not edit.
! Rendered to ~/.cache/wal/colors-dwm.Xresources, merged into the X resource
! database by scripts/setwallpaper.sh, then picked up by the dwm xrdb patch
! (XRDB_PATCH in dwm/patches.def.h). Mod+Shift+F5 re-reads it without a restart.
!
! The role mapping mirrors the hand-tuned palette in dwm/config.def.h:
!   background -> window/bar background     color0 -> raised background, borders
!   foreground -> normal text               color4 -> accent (was Nord #88C0D0)
!   color1     -> urgent (was Nord #BF616A)

dwm.normfgcolor:              {foreground}
dwm.normbgcolor:              {background}
dwm.normbordercolor:          {color0}
dwm.normfloatcolor:           {color4}

dwm.selfgcolor:               {foreground}
dwm.selbgcolor:               {color4}
dwm.selbordercolor:           {color4}
dwm.selfloatcolor:            {color4}

dwm.titlenormfgcolor:         {foreground}
dwm.titlenormbgcolor:         {color0}
dwm.titlenormbordercolor:     {color0}
dwm.titlenormfloatcolor:      {color4}

dwm.titleselfgcolor:          {background}
dwm.titleselbgcolor:          {color4}
dwm.titleselbordercolor:      {color4}
dwm.titleselfloatcolor:       {color4}

dwm.tagsnormfgcolor:          {foreground}
dwm.tagsnormbgcolor:          {background}
dwm.tagsnormbordercolor:      {color0}
dwm.tagsnormfloatcolor:       {color4}

dwm.tagsselfgcolor:           {background}
dwm.tagsselbgcolor:           {color4}
dwm.tagsselbordercolor:       {color4}
dwm.tagsselfloatcolor:        {color4}

! Awesomebar: hidden/minimised clients are dimmed rather than inverted.
dwm.hidnormfgcolor:           {color4}
dwm.hidselfgcolor:            {color6}
dwm.hidnormbgcolor:           {background}
dwm.hidselbgcolor:            {background}

dwm.urgfgcolor:               {foreground}
dwm.urgbgcolor:               {background}
dwm.urgbordercolor:           {color1}
dwm.urgfloatcolor:            {color1}
